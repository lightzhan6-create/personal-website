---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"
import { formatDate } from "@/lib/utils"

const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const selectedProjects = (await getCollection("projects"))
  .sort((a, b) => {
    const aDate = a.data.startDate?.getTime() ?? 0
    const bDate = b.data.startDate?.getTime() ?? 0
    return bDate - aDate
  })
  .slice(0, 1)

const coreAreas = [
  {
    number: "01",
    title: "International B2B Sales",
    label: "Global business practice",
    description:
      "Global customer development, business communication and B2B sales.",
    points: ["Customer development", "Business communication", "Sales operations"],
  },
  {
    number: "02",
    title: "Electronics Manufacturing",
    label: "Industry and process",
    description:
      "SMT, THT, production equipment, automation and electronics manufacturing.",
    points: ["SMT / THT", "Production equipment", "Automation"],
  },
  {
    number: "03",
    title: "AI Operations",
    label: "Applied workflow design",
    description:
      "AI tools, workflows, automation and practical use of AI in daily work.",
    points: ["AI tools", "Workflow design", "Practical automation"],
  },
]
---

<Layout variant="home">
  <MetaPage
    slot="head"
    description="Light's personal portfolio for international B2B sales, electronics manufacturing, and AI-assisted operations."
  />

  <div class="portfolio-home">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-copy" data-enter>
          <p class="eyebrow"><span></span> Personal practice / 2026</p>
          <h1 id="home-title">LIGHT</h1>
          <p class="hero-focus">
            International Sales <span aria-hidden="true">&middot;</span>
            Electronics Manufacturing <span aria-hidden="true">&middot;</span> AI Operations
          </p>
          <p class="hero-description">
            Working across global B2B business, electronics manufacturing and AI-assisted workflows.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#areas">Explore focus areas <span aria-hidden="true">&rarr;</span></a>
            <a class="button button-secondary" href="/about">About Light</a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Three connected areas of practice" data-enter>
          <div class="visual-topline">
            <span>WORK MAP</span>
            <span>01 / 03</span>
          </div>
          <div class="visual-core">
            <span class="visual-orbit visual-orbit-one"></span>
            <span class="visual-orbit visual-orbit-two"></span>
            <span class="visual-node visual-node-one">B2B</span>
            <span class="visual-node visual-node-two">SMT</span>
            <span class="visual-node visual-node-three">AI</span>
            <span class="visual-center">L</span>
          </div>
          <div class="visual-legend">
            <div><span class="legend-marker marker-teal"></span><span>Global business</span></div>
            <div><span class="legend-marker marker-green"></span><span>Manufacturing systems</span></div>
            <div><span class="legend-marker marker-dark"></span><span>Operational intelligence</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="about-section section" aria-labelledby="about-heading">
      <div class="section-container about-layout">
        <div class="section-intro" data-enter>
          <p class="eyebrow"><span></span> 01 / About</p>
          <p class="section-index">PERSONAL<br />PERSPECTIVE</p>
        </div>
        <div class="about-content" data-enter>
          <h2 id="about-heading">Business, process and technology should make sense together.</h2>
          <div class="about-body">
            <p>
              I work with the conversations, systems and operational details behind international growth. This is a personal space for notes on manufacturing, overseas sales and AI tools that make valuable work easier to repeat.
            </p>
            <a class="text-link" href="/about">More about Light <span aria-hidden="true">&rarr;</span></a>
          </div>
          <dl class="about-details">
            <div><dt>Perspective</dt><dd>Commercial and operational</dd></div>
            <div><dt>Working context</dt><dd>International and technical</dd></div>
            <div><dt>Method</dt><dd>Practical, clear and iterative</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="areas" class="areas-section section" aria-labelledby="areas-heading">
      <div class="section-container">
        <header class="section-header section-header-centered" data-enter>
          <p class="eyebrow"><span></span> 02 / Core areas</p>
          <h2 id="areas-heading">Three connected areas of practice.</h2>
          <p>Each one informs how I think about people, process and practical work.</p>
        </header>

        <div class="area-grid">
          {
            coreAreas.map((area, index) => (
              <article class:list={["area-card", `area-card-${index + 1}`]} data-enter>
                <div class="area-card-topline">
                  <span>{area.number}</span>
                  <span>{area.label}</span>
                </div>
                <div class="area-card-icon" aria-hidden="true">
                  <span>{area.number}</span>
                </div>
                <h3>{area.title}</h3>
                <p>{area.description}</p>
                <ul aria-label={`${area.title} focus areas`}>
                  {area.points.map((point) => <li>{point}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="projects" class="projects-section section" aria-labelledby="projects-heading">
      <div class="section-container">
        <header class="section-header projects-header" data-enter>
          <div>
            <p class="eyebrow"><span></span> 03 / Selected focus</p>
            <h2 id="projects-heading">Work shaped around useful systems.</h2>
          </div>
          <p>Current work and future case material, presented without invented outcomes.</p>
        </header>

        <div class="project-showcase">
          {
            selectedProjects.map((project) => (
              <a
                class="project-feature"
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                data-enter
              >
                <div class="project-feature-visual" aria-hidden="true">
                  <span class="project-signal signal-one"></span>
                  <span class="project-signal signal-two"></span>
                  <span class="project-signal signal-three"></span>
                  <span class="project-monogram">L</span>
                  <span class="project-grid-label">PERSONAL WEBSITE<br />ONGOING</span>
                </div>
                <div class="project-feature-copy">
                  <p class="project-label">Selected project / {project.data.startDate && formatDate(project.data.startDate)}</p>
                  <h3>{project.data.name}</h3>
                  <p>{project.data.description}</p>
                  <span class="text-link">View project <span aria-hidden="true">&nearr;</span></span>
                </div>
              </a>
            ))
          }

          <article class="focus-panel" data-enter>
            <div class="focus-panel-index">02</div>
            <div>
              <p class="project-label">Focus area / details to be added</p>
              <h3>International B2B systems</h3>
              <p>[Approaches, working methods and observations will be added here.]</p>
            </div>
          </article>
          <article class="focus-panel focus-panel-dark" data-enter>
            <div class="focus-panel-index">03</div>
            <div>
              <p class="project-label">Focus area / details to be added</p>
              <h3>AI-assisted workflows</h3>
              <p>[Practical examples of operations and automation are in development.]</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="blog" class="writing-section section" aria-labelledby="writing-heading">
      <div class="section-container writing-layout">
        <header class="section-header writing-header" data-enter>
          <p class="eyebrow"><span></span> 04 / Writing</p>
          <h2 id="writing-heading">Notes from the field.</h2>
          <p>Manufacturing, international B2B, AI tools and industry observations.</p>
          <a class="text-link" href="/blog">Browse all writing <span aria-hidden="true">&rarr;</span></a>
        </header>

        {
          latestPosts.length > 0 ? (
            <div class="post-list">
              {latestPosts.map((post, index) => (
                <a class="post-card" href={`/blog/${post.id}`} data-enter>
                  <div class="post-card-topline">
                    <span>ARTICLE {String(index + 1).padStart(2, "0")}</span>
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="post-card-link">Read article <span aria-hidden="true">&rarr;</span></span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-state">[Writing will appear here when published.]</p>
          )
        }
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-heading">
      <div class="contact-grid" aria-hidden="true"></div>
      <div class="section-container contact-layout">
        <div class="contact-intro" data-enter>
          <p class="eyebrow"><span></span> 05 / Contact</p>
          <p>OPEN TO THOUGHTFUL<br />CONVERSATIONS</p>
        </div>
        <div class="contact-content" data-enter>
          <h2 id="contact-heading">Let's connect.</h2>
          <p class="contact-focus">International Sales <span>&middot;</span> Electronics Manufacturing <span>&middot;</span> AI</p>
          <p class="contact-copy">For thoughtful conversations and future collaborations, contact details will be added here.</p>
          <div class="contact-actions">
            <span class="contact-placeholder">Preferred email: [to be added]</span>
            <a class="button button-accent" href="https://github.com/lightzhan6-create" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">&nearr;</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .portfolio-home {
    --home-max-width: 75rem;
    --home-pad: clamp(1.25rem, 3.5vw, 3.5rem);
    color: var(--tech-ink);
    overflow: hidden;
  }

  .portfolio-home :is(h1, h2, h3, p) {
    margin: 0;
  }

  .section-container,
  .hero-inner {
    width: min(100% - (2 * var(--home-pad)), var(--home-max-width));
    margin-inline: auto;
  }

  .section {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .eyebrow,
  .section-index,
  .project-label,
  .post-card-topline,
  .focus-panel-index,
  .visual-topline,
  .contact-placeholder {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--tech-signal-dark);
  }

  .eyebrow span {
    width: 1.75rem;
    height: 2px;
    background: currentColor;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.85rem 1.45rem;
    border: 2px solid transparent;
    border-radius: 0.5rem;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: white;
    background: var(--tech-teal-deep);
    box-shadow: var(--tech-shadow-sm);
  }

  .button-primary:hover {
    color: white;
    background: var(--tech-deep);
    box-shadow: var(--tech-shadow);
  }

  .button-secondary {
    color: var(--tech-teal-deep);
    border-color: var(--tech-teal-deep);
    background: color-mix(in oklab, var(--tech-surface) 80%, transparent);
  }

  .button-secondary:hover {
    color: white;
    border-color: var(--tech-deep);
    background: var(--tech-deep);
  }

  .button-accent {
    color: var(--tech-deep);
    background: var(--tech-signal);
    box-shadow: var(--tech-shadow-sm);
  }

  .button-accent:hover {
    color: white;
    background: var(--tech-signal-dark);
    box-shadow: var(--tech-shadow);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    color: var(--tech-teal-deep);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    transition: transform 180ms ease;
  }

  .text-link:hover span {
    transform: translateX(0.3rem);
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(48rem, calc(100svh - 4.5rem));
    overflow: hidden;
    background:
      radial-gradient(54rem 30rem at 91% 0%, color-mix(in oklab, var(--tech-teal) 18%, transparent), transparent 64%),
      linear-gradient(180deg, var(--tech-mint) 0%, var(--tech-surface) 100%);
    border-block-end: 1px solid var(--tech-line);
  }

  .hero-grid,
  .contact-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    opacity: 0.55;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--tech-teal-deep) 9%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--tech-teal-deep) 9%, transparent) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(to right, transparent 0%, black 45%, transparent 100%);
  }

  .hero-glow {
    position: absolute;
    inset: auto -15% -30% auto;
    z-index: -1;
    width: min(46rem, 62vw);
    aspect-ratio: 1;
    border: 1px solid color-mix(in oklab, var(--tech-teal) 45%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 4rem color-mix(in oklab, var(--tech-teal) 4%, transparent), 0 0 0 8rem color-mix(in oklab, var(--tech-teal) 3%, transparent);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(20rem, 0.82fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero h1 {
    margin-block: 0.85rem 1.25rem;
    color: var(--tech-ink);
    font-size: clamp(5.5rem, 13.8vw, 11.5rem);
    font-weight: 700;
    letter-spacing: -0.09em;
    line-height: 0.72;
    text-indent: -0.085em;
  }

  .hero-focus {
    max-width: 41rem;
    color: var(--tech-ink-2);
    font-size: clamp(1.16rem, 1.75vw, 1.45rem);
    font-weight: 650;
    line-height: 1.34;
  }

  .hero-focus span,
  .contact-focus span {
    color: var(--tech-teal);
  }

  .hero-description {
    max-width: 37rem;
    margin-block: 1.4rem 1.85rem !important;
    color: var(--tech-muted);
    font-size: clamp(1.06rem, 1.35vw, 1.2rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero-visual {
    position: relative;
    min-height: 29rem;
    overflow: hidden;
    color: var(--tech-ink);
    background:
      linear-gradient(145deg, color-mix(in oklab, var(--tech-surface) 94%, transparent), color-mix(in oklab, var(--tech-mint) 70%, transparent)),
      var(--tech-surface);
    border: 1px solid var(--tech-line-strong);
    border-radius: 1.1rem;
    box-shadow: var(--tech-shadow-lg);
  }

  .hero-visual::before,
  .hero-visual::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .hero-visual::before {
    inset: 1rem;
    border: 1px solid color-mix(in oklab, var(--tech-teal) 26%, transparent);
    border-radius: 0.7rem;
  }

  .hero-visual::after {
    inset: auto 1rem 1rem auto;
    width: 4.2rem;
    aspect-ratio: 1;
    border-right: 2px solid var(--tech-signal);
    border-bottom: 2px solid var(--tech-signal);
  }

  .visual-topline,
  .visual-legend {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .visual-topline {
    padding: 1.5rem 1.5rem 0;
    color: var(--tech-muted);
  }

  .visual-core {
    position: relative;
    display: grid;
    place-items: center;
    height: 21rem;
  }

  .visual-orbit {
    position: absolute;
    display: block;
    border: 1px solid color-mix(in oklab, var(--tech-teal) 45%, transparent);
    border-radius: 50%;
  }

  .visual-orbit-one {
    width: 12.5rem;
    height: 12.5rem;
  }

  .visual-orbit-two {
    width: 20rem;
    height: 20rem;
    border-color: color-mix(in oklab, var(--tech-signal) 45%, transparent);
  }

  .visual-center {
    position: relative;
    z-index: 1;
    display: grid;
    width: 6.5rem;
    aspect-ratio: 1;
    place-items: center;
    color: white;
    background: var(--tech-deep);
    border: 0.5rem solid color-mix(in oklab, var(--tech-teal) 28%, var(--tech-surface));
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--tech-teal), 0 1.2rem 2.4rem color-mix(in oklab, var(--tech-deep) 22%, transparent);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .visual-node {
    position: absolute;
    z-index: 1;
    display: grid;
    width: 3.25rem;
    aspect-ratio: 1;
    place-items: center;
    color: var(--tech-deep);
    background: var(--tech-signal);
    border: 3px solid var(--tech-surface);
    border-radius: 50%;
    box-shadow: var(--tech-shadow-sm);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
  }

  .visual-node-one { transform: translate(-7.5rem, -5.6rem); }
  .visual-node-two { transform: translate(7.8rem, -3.5rem); background: var(--tech-teal); color: white; }
  .visual-node-three { transform: translate(2.4rem, 7.8rem); background: var(--tech-deep); color: white; }

  .visual-legend {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.48rem;
    padding: 0 1.5rem 1.5rem;
    color: var(--tech-muted);
    font-size: 0.77rem;
    line-height: 1.2;
  }

  .visual-legend div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-marker {
    display: block;
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
  }

  .marker-teal { background: var(--tech-teal); }
  .marker-green { background: var(--tech-signal); }
  .marker-dark { background: var(--tech-deep); }

  .about-section,
  .writing-section {
    background: var(--tech-alt);
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(2.5rem, 8vw, 9rem);
  }

  .section-index {
    margin-top: 1.75rem !important;
    color: var(--tech-muted);
  }

  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.82fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
  }

  .about-content h2,
  .section-header h2,
  .contact-content h2 {
    color: var(--tech-ink);
    font-size: clamp(2.2rem, 4.5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.96;
  }

  .about-body {
    padding-top: 0.35rem;
  }

  .about-body p {
    color: var(--tech-muted);
    font-size: clamp(1.05rem, 1.35vw, 1.22rem);
    line-height: 1.65;
  }

  .about-body .text-link {
    margin-top: 1.4rem;
  }

  .about-details {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-block: 1px solid var(--tech-line);
  }

  .about-details div {
    padding: 1.2rem 1rem 1.25rem 0;
    border-inline-end: 1px solid var(--tech-line);
  }

  .about-details div + div {
    padding-inline-start: 1.25rem;
  }

  .about-details div:last-child { border-inline-end: 0; }

  .about-details dt {
    margin-bottom: 0.35rem;
    color: var(--tech-signal-dark);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-details dd {
    margin: 0;
    color: var(--tech-ink-2);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .areas-section { background: var(--tech-surface); }

  .section-header { max-width: 48rem; }

  .section-header h2 { margin-top: 0.8rem; }

  .section-header > p:last-child {
    margin-top: 1rem;
    color: var(--tech-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .section-header-centered {
    margin-inline: auto;
    text-align: center;
  }

  .section-header-centered .eyebrow { justify-content: center; }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-top: clamp(2.8rem, 5vw, 4.5rem);
  }

  .area-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 30rem;
    padding: 1.45rem;
    overflow: hidden;
    background: var(--tech-card);
    border: 1px solid var(--tech-line);
    border-top: 4px solid var(--tech-teal);
    border-radius: 0.82rem;
    box-shadow: var(--tech-shadow-sm);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .area-card-2 { border-top-color: var(--tech-signal); }
  .area-card-3 { border-top-color: var(--tech-deep); }

  .area-card:hover {
    z-index: 1;
    transform: translateY(-0.35rem);
    border-color: var(--tech-line-strong);
    box-shadow: var(--tech-shadow);
  }

  .area-card-topline,
  .post-card-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--tech-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .area-card-icon {
    display: grid;
    width: 4rem;
