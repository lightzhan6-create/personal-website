---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"
import { formatDate } from "@/lib/utils"

const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)

const selectedProjects = (await getCollection("projects"))
  .sort((a, b) => {
    const aDate = a.data.startDate?.getTime() ?? 0
    const bDate = b.data.startDate?.getTime() ?? 0
    return bDate - aDate
  })
  .slice(0, 2)
---

<Layout>
  <MetaPage
    slot="head"
    description="Light's personal website for international B2B sales, electronics manufacturing, and AI-assisted workflows."
  />
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <p class="eyebrow">Personal website / International B2B</p>
      <h1 id="home-title">Light</h1>
      <p class="hero-focus">
        International Sales · Electronics Manufacturing · AI Operations
      </p>
      <p class="hero-introduction">
        I work at the intersection of international B2B sales, electronics
        manufacturing and AI-assisted workflows.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">Get in touch</a>
        <a class="button button-secondary" href="/about">About Light</a>
      </div>
    </section>

    <section class="intro-section" aria-labelledby="about-heading">
      <div class="section-heading">
        <p class="eyebrow">01 / About</p>
        <h2 id="about-heading">A practical point of view.</h2>
      </div>
      <div class="intro-copy">
        <p>
          This is a personal space for thinking in public about the work behind
          international growth: people, manufacturing, systems and the tools
          that make good work easier to repeat.
        </p>
        <a class="text-link" href="/about">Read the introduction <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section aria-labelledby="what-i-do-heading">
      <div class="section-heading">
        <p class="eyebrow">02 / What I do</p>
        <h2 id="what-i-do-heading">Work across the commercial and operational side of industry.</h2>
      </div>
      <div class="focus-grid">
        <article class="focus-card">
          <p class="card-number">01</p>
          <h3>International B2B Sales</h3>
          <p>
            International communication, overseas customer development and practical sales workflows.
          </p>
        </article>
        <article class="focus-card">
          <p class="card-number">02</p>
          <h3>Electronics Manufacturing</h3>
          <p>
            SMT / THT equipment, factory automation and the context around electronics manufacturing.
          </p>
        </article>
        <article class="focus-card">
          <p class="card-number">03</p>
          <h3>AI Operations</h3>
          <p>
            AI tools, workflows and automation for clearer, more repeatable work.
          </p>
        </article>
      </div>
    </section>

    <section aria-labelledby="focus-heading">
      <div class="section-heading">
        <p class="eyebrow">03 / Focus areas</p>
        <h2 id="focus-heading">The questions I keep returning to.</h2>
      </div>
      <div class="topic-list" role="list">
        <span role="listitem">SMT / THT manufacturing</span>
        <span role="listitem">Electronics manufacturing</span>
        <span role="listitem">International B2B sales</span>
        <span role="listitem">Overseas customer development</span>
        <span role="listitem">AI tools and workflows</span>
        <span role="listitem">Automation and industry observations</span>
      </div>
    </section>

    <section aria-labelledby="writing-heading">
      <div class="section-heading section-heading-inline">
        <div>
          <p class="eyebrow">04 / Latest writing</p>
          <h2 id="writing-heading">Notes in progress.</h2>
        </div>
        <a class="text-link" href="/blog">View all writing <span aria-hidden="true">→</span></a>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="article-grid">
            {latestPosts.map((post) => (
              <a class="content-card" href={`/blog/${post.id}`}>
                <p class="content-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {post.data.tags?.[0] && <span>#{post.data.tags[0]}</span>}
                </p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">[Writing will appear here as it is published.]</p>
        )
      }
    </section>

    <section aria-labelledby="projects-heading">
      <div class="section-heading section-heading-inline">
        <div>
          <p class="eyebrow">05 / Selected projects</p>
          <h2 id="projects-heading">Work worth keeping close.</h2>
        </div>
        <a class="text-link" href="/projects">View all projects <span aria-hidden="true">→</span></a>
      </div>
      {
        selectedProjects.length > 0 ? (
          <div class="article-grid">
            {selectedProjects.map((project) => (
              <a
                class="content-card"
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <p class="content-meta">
                  {project.data.startDate && (
                    <time datetime={project.data.startDate.toISOString()}>
                      {formatDate(project.data.startDate)}
                    </time>
                  )}
                  <span>Project</span>
                </p>
                <h3>{project.data.name}</h3>
                <p>{project.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">[Selected projects will be added here.]</p>
        )
      }
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-heading">
      <p class="eyebrow">06 / Contact</p>
      <h2 id="contact-heading">Open to thoughtful conversations.</h2>
      <p>
        For conversations about international sales, electronics manufacturing
        or practical AI workflows, please use the contact details below.
      </p>
      <p class="contact-placeholder">Preferred email address: <strong>[to be added]</strong></p>
      <a class="text-link" href="https://github.com/lightzhan6-create" target="_blank" rel="noopener noreferrer">
        Find me on GitHub <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Layout>

<style>
  .home-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    padding-block-end: var(--space-l);
  }

  .home-hero {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 3rem) var(--space-xl-2xl);
    border-block-end: 1px solid var(--border);
  }

  .home-hero::after {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: var(--space-m);
    color: color-mix(in oklab, var(--accent) 17%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(4rem, 11vw, 8rem);
    font-weight: var(--font-weight-medium);
    line-height: 0.7;
    content: "L";
    pointer-events: none;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    max-inline-size: 8ch;
    margin-block: var(--space-xs) var(--space-m);
    font-size: clamp(4.5rem, 13vw, 8.5rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.09em;
    line-height: 0.78;
  }

  h2 {
    max-inline-size: 20ch;
    font-size: clamp(1.8rem, 4.5vw, 3.2rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  h3 {
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
  }

  .hero-focus {
    position: relative;
    z-index: 1;
    max-inline-size: 40rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }

  .hero-introduction {
    position: relative;
    z-index: 1;
    max-inline-size: 39rem;
    margin-block-start: var(--space-s);
    color: var(--prose-foreground);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .button-primary {
    color: var(--primary-foreground);
    background: var(--foreground);
    border-color: var(--foreground);

    &:hover {
      color: var(--primary-foreground);
      background: var(--accent);
      border-color: var(--accent);
    }
  }

  .button-secondary {
    color: var(--foreground);
    background: transparent;

    &:hover {
      background: var(--accent-subtle);
      border-color: var(--accent);
    }
  }

  .intro-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l-xl);
    align-items: start;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-end: var(--space-l);
  }

  .section-heading-inline {
    flex-direction: row;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .intro-section .section-heading {
    margin-block-end: 0;
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-inline-size: 34rem;
    color: var(--prose-foreground);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .text-link {
    width: fit-content;
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .focus-grid,
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  .focus-card,
  .content-card {
    display: flex;
    flex-direction: column;
    min-block-size: 15rem;
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .focus-card {
    gap: var(--space-xs);
  }

  .focus-card > p:last-child,
  .content-card > p:last-child {
    color: var(--prose-foreground);
    line-height: 1.45;
  }

  .card-number,
  .content-meta {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .focus-card > p:last-child {
    margin-block-start: auto;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .topic-list span {
    padding: 0.45rem 0.75rem;
    color: var(--prose-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  .article-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content-card {
    gap: var(--space-xs);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;

    &:hover {
      background: color-mix(in oklab, var(--accent-subtle) 55%, transparent);
      border-color: var(--accent);
      transform: translateY(-0.15rem);
    }
  }

  .content-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .content-meta span::before {
    margin-inline-end: var(--space-2xs);
    color: var(--muted-foreground);
    content: "/";
  }

  .empty-state,
  .contact-placeholder {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l-xl);
    background: var(--accent-subtle);
    border: 1px solid color-mix(in oklab, var(--accent) 35%, var(--border));
    border-radius: var(--radius-xl);
  }

  .contact-section > p:not(.eyebrow):not(.contact-placeholder) {
    max-inline-size: 38rem;
    color: var(--prose-foreground);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  @media (width < 48rem) {
    .intro-section,
    .focus-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-heading-inline {
      align-items: start;
      flex-direction: column;
    }

    .focus-card,
    .content-card {
      min-block-size: auto;
    }
  }

  @media (width < 30rem) {
    .home-page {
      gap: var(--space-2xl);
    }

    .home-hero::after {
      display: none;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
</style>
