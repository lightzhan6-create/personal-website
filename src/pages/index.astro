---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"
import { formatDate } from "@/lib/utils"

const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const selectedProjects = (await getCollection("projects"))
  .sort((a, b) => {
    const aDate = a.data.startDate?.getTime() ?? 0
    const bDate = b.data.startDate?.getTime() ?? 0
    return bDate - aDate
  })
  .slice(0, 1)
---

<Layout variant="home">
  <MetaPage
    slot="head"
    description="Light's personal portfolio for international B2B sales, electronics manufacturing, and AI-assisted operations."
  />

  <div class="portfolio-home">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-topline" data-enter>
        <p>Independent portfolio</p>
        <p>International / Industrial / Operational</p>
      </div>

      <div class="hero-title-wrap">
        <p class="hero-index" data-enter>01 — PERSONAL PRACTICE</p>
        <h1 id="home-title" data-enter>LIGHT</h1>
      </div>

      <div class="hero-footer" data-enter>
        <p class="hero-statement">
          At the intersection of international B2B sales, electronics manufacturing and AI-assisted workflows.
        </p>
        <div class="hero-disciplines" aria-label="Professional focus">
          <span>International Sales</span>
          <span>Electronics Manufacturing</span>
          <span>AI Operations</span>
        </div>
      </div>
    </section>

    <section class="profile-section section-space" aria-labelledby="about-heading">
      <div class="section-marker" data-enter>
        <span>02</span>
        <span>About</span>
      </div>
      <div class="profile-copy" data-enter>
        <h2 id="about-heading">Commercial thinking, grounded in how work actually moves.</h2>
        <div>
          <p>
            I work with the conversations, systems and operational details behind international growth. This is a personal space for notes on manufacturing, overseas sales and AI tools that make valuable work easier to repeat.
          </p>
          <a class="inline-link" href="/about">More about Light <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    <section class="disciplines" aria-labelledby="disciplines-heading">
      <div class="disciplines-intro section-space">
        <div class="section-marker section-marker-light" data-enter>
          <span>03</span>
          <span>Core areas</span>
        </div>
        <h2 id="disciplines-heading" data-enter>Three disciplines. One practical point of view.</h2>
      </div>

      <div class="discipline-list">
        <article class="discipline-row" data-enter>
          <p class="discipline-number">01</p>
          <h3>International<br />B2B Sales</h3>
          <p>Overseas customer development, international communication and the daily operating rhythm behind a considered sales process.</p>
        </article>
        <article class="discipline-row" data-enter>
          <p class="discipline-number">02</p>
          <h3>Electronics<br />Manufacturing</h3>
          <p>SMT / THT equipment, automation and the manufacturing context that turns a technical product into a useful solution.</p>
        </article>
        <article class="discipline-row" data-enter>
          <p class="discipline-number">03</p>
          <h3>AI<br />Operations</h3>
          <p>AI-assisted workflows, practical automation and clearer systems for recurring operational work.</p>
        </article>
      </div>
    </section>

    <section class="selected-work section-space" aria-labelledby="selected-work-heading">
      <div class="section-heading" data-enter>
        <div class="section-marker">
          <span>04</span>
          <span>Selected work / focus</span>
        </div>
        <h2 id="selected-work-heading">Work in progress, organised with intent.</h2>
      </div>

      <div class="work-list">
        {
          selectedProjects.map((project) => (
            <a
              class="work-row work-row-link"
              href={project.data.link}
              target="_blank"
              rel="noopener noreferrer"
              data-enter
            >
              <p class="work-type">Selected project / {project.data.startDate && formatDate(project.data.startDate)}</p>
              <h3>{project.data.name}</h3>
              <p class="work-description">{project.data.description}</p>
              <span class="work-arrow" aria-hidden="true">&nearr;</span>
            </a>
          ))
        }
        <article class="work-row" data-enter>
          <p class="work-type">Focus area / details to be added</p>
          <h3>International B2B systems</h3>
          <p class="work-description">[A selection of approaches, working methods and observations will be added here.]</p>
          <span class="work-arrow" aria-hidden="true">&mdash;</span>
        </article>
        <article class="work-row" data-enter>
          <p class="work-type">Focus area / details to be added</p>
          <h3>AI-assisted workflows</h3>
          <p class="work-description">[Examples of practical AI operations and automation are in development.]</p>
          <span class="work-arrow" aria-hidden="true">&mdash;</span>
        </article>
      </div>
    </section>

    <section class="writing-section section-space" aria-labelledby="writing-heading">
      <div class="section-heading section-heading-inline" data-enter>
        <div>
          <div class="section-marker">
            <span>05</span>
            <span>Writing</span>
          </div>
          <h2 id="writing-heading">Notes from the field.</h2>
        </div>
        <a class="inline-link" href="/blog">All writing <span aria-hidden="true">&rarr;</span></a>
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="writing-list">
            {latestPosts.map((post, index) => (
              <a class="writing-row" href={`/blog/${post.id}`} data-enter>
                <span class="writing-number">0{index + 1}</span>
                <div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <p class="writing-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {post.data.tags?.[0] && <span>#{post.data.tags[0]}</span>}
                </p>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">[Writing will appear here when published.]</p>
        )
      }
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-heading">
      <div class="contact-grid" aria-hidden="true"></div>
      <div class="section-marker section-marker-light" data-enter>
        <span>06</span>
        <span>Contact</span>
      </div>
      <div class="contact-content" data-enter>
        <h2 id="contact-heading">Let's connect.</h2>
        <p>International Sales <span>&middot;</span> Electronics Manufacturing <span>&middot;</span> AI</p>
        <p class="contact-copy">For thoughtful conversations and future collaborations, contact details will be added here.</p>
        <p class="contact-placeholder">Preferred email: [to be added]</p>
        <a href="https://github.com/lightzhan6-create" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">&nearr;</span></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .portfolio-home {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 12vw, 10rem);
    padding-block-end: var(--space-2xl);
  }

  .hero,
  .contact-section {
    position: relative;
    overflow: hidden;
    color: var(--surface-strong-text);
    background: var(--surface-strong);
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-block-size: min(50rem, calc(100svh - var(--page-offset-top) - var(--space-l)));
    padding: clamp(1.25rem, 2.75vw, 2.75rem);
  }

  .hero-grid,
  .contact-grid {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--surface-strong-text) 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--surface-strong-text) 8%, transparent) 1px, transparent 1px);
    background-size: clamp(2.75rem, 7vw, 5.5rem) clamp(2.75rem, 7vw, 5.5rem);
    mask-image: linear-gradient(to bottom, black, transparent 84%);
  }

  .hero::after {
    position: absolute;
    inset-inline-end: -0.09em;
    inset-block-start: 11%;
    z-index: 0;
    color: color-mix(in oklab, var(--accent) 55%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(13rem, 33vw, 29rem);
    font-weight: var(--font-weight-medium);
    line-height: 0.7;
    content: "L";
    pointer-events: none;
  }

  .hero-topline,
  .hero-title-wrap,
  .hero-footer,
  .contact-content,
  .contact-section > .section-marker {
    position: relative;
    z-index: 1;
  }

  .hero-topline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    color: var(--surface-strong-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .hero-title-wrap {
    margin-block: auto;
    padding-block: clamp(4.5rem, 12vw, 10rem) var(--space-l);
  }

  .hero-index,
  .section-marker,
  .work-type,
  .writing-number,
  .writing-meta,
  .contact-placeholder {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
  }

  .hero-index {
    margin: 0 0 var(--space-xs);
    color: var(--accent);
  }

  .hero h1,
  .portfolio-home h2,
  .portfolio-home h3,
  .portfolio-home p {
    margin: 0;
  }

  .hero h1 {
    max-inline-size: 100%;
    font-size: clamp(5rem, 16.2vw, 15.5rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.105em;
    line-height: 0.7;
    text-indent: -0.09em;
  }

  .hero-footer {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: var(--space-l-xl);
    align-items: end;
    padding-block-start: var(--space-m);
    border-block-start: 1px solid color-mix(in oklab, var(--surface-strong-text) 22%, transparent);
  }

  .hero-statement {
    max-inline-size: 45rem;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.25;
  }

  .hero-disciplines {
    display: grid;
    gap: var(--space-3xs);
    color: var(--surface-strong-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero-disciplines span::before {
    display: inline-block;
    inline-size: 0.9rem;
    margin-inline-end: 0.5rem;
    color: var(--accent);
    content: "—";
  }

  .section-space {
    padding-inline: clamp(0rem, 3vw, 2.5rem);
  }

  .section-marker {
    display: flex;
    gap: var(--space-xs);
    color: var(--accent);
    text-transform: uppercase;
  }

  .section-marker span:first-child {
    color: var(--muted-foreground);
  }

  .section-marker-light {
    color: var(--accent);
  }

  .section-marker-light span:first-child {
    color: var(--surface-strong-muted);
  }

  .profile-section {
    display: grid;
    grid-template-columns: minmax(11rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-xl-2xl);
    align-items: start;
  }

  .profile-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: var(--space-l-xl);
  }

  .portfolio-home h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .profile-copy > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    color: var(--prose-foreground);
    font-size: var(--step-1);
    line-height: 1.48;
  }

  .inline-link {
    width: fit-content;
    color: var(--foreground);
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .inline-link span {
    display: inline-block;
    margin-inline-start: 0.2rem;
    transition: transform 180ms ease;
  }

  .inline-link:hover span {
    transform: translateX(0.28rem);
  }

  .disciplines {
    padding-block: clamp(4rem, 9vw, 8rem);
    color: var(--surface-strong-text);
    background: var(--surface-strong);
  }

  .disciplines-intro {
    display: grid;
    grid-template-columns: minmax(11rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-xl-2xl);
    margin-block-end: var(--space-xl);
  }

  .disciplines h2 {
    max-inline-size: 17ch;
  }

  .discipline-list {
    border-block: 1px solid color-mix(in oklab, var(--surface-strong-text) 20%, transparent);
  }

  .discipline-row {
    display: grid;
    grid-template-columns: minmax(5rem, 0.5fr) minmax(15rem, 1.1fr) minmax(15rem, 0.8fr);
    gap: var(--space-l-xl);
    align-items: end;
    padding: clamp(1.5rem, 3.5vw, 3.25rem) clamp(0rem, 3vw, 2.5rem);
    border-block-end: 1px solid color-mix(in oklab, var(--surface-strong-text) 20%, transparent);
    transition: background-color 180ms ease;
  }

  .discipline-row:last-child {
    border-block-end: 0;
  }

  .discipline-row:hover {
    background: color-mix(in oklab, var(--surface-strong-text) 5%, transparent);
  }

  .discipline-number {
    align-self: start;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .discipline-row h3 {
    font-size: clamp(2.1rem, 4.6vw, 4.75rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.075em;
    line-height: 0.85;
  }

  .discipline-row > p:last-child {
    max-inline-size: 26rem;
    color: var(--surface-strong-muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-end: var(--space-xl);
  }

  .section-heading-inline {
    flex-direction: row;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-l);
  }

  .section-heading h2 {
    max-inline-size: 15ch;
  }

  .work-list {
    border-block-start: 1px solid var(--border);
  }

  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 0.5fr) minmax(0, 1.05fr) minmax(15rem, 0.9fr) auto;
    gap: var(--space-m-l);
    align-items: center;
    padding: var(--space-l) 0;
    border-block-end: 1px solid var(--border);
  }

  .work-row-link {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease, padding-inline 180ms ease;
  }

  .work-row-link:hover {
    padding-inline: var(--space-xs);
    color: var(--accent);
  }

  .work-type {
    color: var(--muted-foreground);
    text-transform: uppercase;
  }

  .work-row h3 {
    font-size: clamp(1.6rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .work-description {
    color: var(--prose-foreground);
    line-height: 1.4;
  }

  .work-arrow {
    color: var(--accent);
    font-size: var(--step-2);
  }

  .writing-section {
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--border);
  }

  .writing-list {
    border-block-start: 1px solid var(--border);
  }

  .writing-row {
    display: grid;
    grid-template-columns: minmax(3rem, 0.2fr) minmax(0, 1.2fr) minmax(10rem, 0.45fr);
    gap: var(--space-m);
    align-items: start;
    padding-block: var(--space-m);
    color: inherit;
    border-block-end: 1px solid var(--border);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .writing-row:hover {
    color: var(--accent);
  }

  .writing-number,
  .writing-meta {
    color: var(--muted-foreground);
  }

  .writing-row h3 {
    margin-block-end: var(--space-3xs);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .writing-row div > p {
    color: var(--prose-foreground);
    line-height: 1.4;
  }

  .writing-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    text-align: end;
  }

  .empty-state {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .contact-section {
    display: grid;
    grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-xl-2xl);
    padding: clamp(2rem, 5vw, 5rem) clamp(1.25rem, 4vw, 4rem);
  }

  .contact-content h2 {
    margin-block: var(--space-xs) var(--space-s);
    font-size: clamp(4rem, 10vw, 9rem);
    letter-spacing: -0.09em;
    line-height: 0.78;
  }

  .contact-content > p:nth-of-type(1) {
    color: var(--surface-strong-text);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: var(--font-weight-medium);
  }

  .contact-content > p:nth-of-type(1) span {
    color: var(--accent);
  }

  .contact-copy {
    max-inline-size: 37rem;
    margin-block: var(--space-l) var(--space-xs) !important;
    color: var(--surface-strong-muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .contact-placeholder {
    color: var(--surface-strong-muted);
  }

  .contact-content > a {
    display: inline-flex;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
    color: var(--surface-strong-text);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .contact-content > a span {
    transition: transform 180ms ease;
  }

  .contact-content > a:hover span {
    transform: translate(0.2rem, -0.2rem);
  }

  [data-enter] {
    animation: rise-in 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-title-wrap[data-enter] {
    animation-delay: 90ms;
  }

  .hero-footer[data-enter],
  .profile-copy[data-enter] {
    animation-delay: 180ms;
  }

  .discipline-row:nth-child(2)[data-enter],
  .work-row:nth-child(2)[data-enter],
  .writing-row:nth-child(2)[data-enter] {
    animation-delay: 70ms;
  }

  .discipline-row:nth-child(3)[data-enter],
  .work-row:nth-child(3)[data-enter],
  .writing-row:nth-child(3)[data-enter] {
    animation-delay: 140ms;
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(0.9rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (width < 56rem) {
    .hero-footer,
    .profile-section,
    .profile-copy,
    .disciplines-intro,
    .contact-section {
      grid-template-columns: 1fr;
    }

    .profile-section,
    .disciplines-intro,
    .contact-section {
      gap: var(--space-l);
    }

    .discipline-row,
    .work-row,
    .writing-row {
      grid-template-columns: minmax(3rem, 0.2fr) minmax(0, 1fr);
      gap: var(--space-xs) var(--space-m);
    }

    .discipline-row > p:last-child,
    .work-description,
    .writing-meta {
      grid-column: 2;
    }

    .work-arrow {
      display: none;
    }

    .writing-meta {
      align-items: start;
      flex-direction: row;
      text-align: start;
    }
  }

  @media (width < 36rem) {
    .portfolio-home {
      gap: var(--space-3xl);
    }

    .hero {
      min-block-size: calc(100svh - var(--bar-nav-height));
      padding: var(--space-s);
    }

    .hero-topline {
      display: block;
    }

    .hero-topline p:last-child {
      display: none;
    }

    .hero-title-wrap {
      padding-block: var(--space-xl) var(--space-l);
    }

    .hero h1 {
      font-size: clamp(4.75rem, 25vw, 7rem);
    }

    .hero-footer {
      gap: var(--space-m);
    }

    .hero-disciplines {
      grid-template-columns: 1fr 1fr;
      font-size: 0.74rem;
    }

    .hero-disciplines span:last-child {
      grid-column: 1 / -1;
    }

    .section-space {
      padding-inline: 0;
    }

    .discipline-row,
    .work-row,
    .writing-row {
      grid-template-columns: 1fr;
    }

    .discipline-row > p:last-child,
    .work-description,
    .writing-meta {
      grid-column: auto;
    }

    .discipline-number,
    .writing-number {
      margin-block-end: var(--space-2xs);
    }

    .discipline-row h3 {
      font-size: clamp(2.65rem, 13vw, 3.7rem);
    }

    .section-heading-inline {
      align-items: start;
      flex-direction: column;
    }

    .contact-section {
      padding-inline: var(--space-s);
    }

    .contact-content h2 {
      font-size: clamp(4rem, 20vw, 5.5rem);
    }
  }
</style>
