---
import Logo from "@/assets/logo.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
---

<aside data-bar>
  <sidebar-inner>
    <a href="/" aria-label={SITE.title}>
      <Logo />
      <span>{SITE.title}</span>
    </a>
    <nav>
      <ul>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item === section && crumbs.length > 0 && pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        {!section &&
            crumbs.map((crumb, i) => (
              <li data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
      </ul>
    </nav>
  </sidebar-inner>
  <sidebar-toggle>
    <ThemeToggle />
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    > a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: fit-content;
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);
      color: var(--foreground);
      text-decoration-line: none;

      svg {
        inline-size: 1.125rem;
        block-size: 1.125rem;
        flex-shrink: 0;
      }

      @media (width < 26rem) {
        span {
          display: none;
        }
      }
    }

    @media (width < 64rem) {
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      color: var(--muted-foreground);

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 64rem) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);

      ul {
        display: none;
      }
    }

    @media (width < 34rem) {
      flex-wrap: wrap;
      column-gap: var(--space-xs);
      row-gap: var(--space-3xs);
      font-size: var(--step--1);
    }
  }

  nav li:has(> ul) > a {
    @media (width < 64rem) {
      color: var(--foreground);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 64rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }
  }

  @media (width < 34rem) {
    aside {
      align-items: flex-start;
    }

    sidebar-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xs);
    }

    sidebar-inner > a span {
      display: inline;
    }

    sidebar-toggle {
      padding-block-start: 0.15rem;
    }
  }

  :global(page-grid[data-layout="home"]) aside {
    position: static;
    flex-direction: row;
    align-items: center;
    width: min(100%, 75rem);
    height: 4.5rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 3.5vw, 3.5rem);
  }

  :global(page-grid[data-layout="home"]) sidebar-inner {
    flex: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);

    > a {
      gap: 0.55rem;
      font-size: 1.05rem;
      letter-spacing: -0.04em;

      svg {
        inline-size: 1.5rem;
        block-size: 1.5rem;
        color: var(--tech-teal-deep);
      }
    }
  }

  :global(page-grid[data-layout="home"]) nav ul {
    flex-direction: row;
    align-items: center;
    gap: 0.25rem;

    a {
      padding: 0.55rem 0.65rem;
      border-radius: 0.45rem;
      color: var(--tech-ink-2);
      font-size: 0.84rem;
      font-weight: 600;
      text-decoration: none;
      transition: color 180ms ease, background-color 180ms ease;

      &:hover,
      &[aria-current="page"] {
        color: var(--tech-teal-deep);
        background: var(--tech-mint);
      }
    }
  }

  :global(page-grid[data-layout="home"]) sidebar-toggle {
    margin-inline: 0 0;
  }

  @media (width < 58rem) {
    :global(page-grid[data-layout="home"]) aside {
      height: auto;
      min-height: 4rem;
      align-items: flex-start;
      padding-block: 0.65rem;
    }

    :global(page-grid[data-layout="home"]) sidebar-inner {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }

    :global(page-grid[data-layout="home"]) nav {
      order: 3;
      flex-basis: 100%;
    }

    :global(page-grid[data-layout="home"]) nav ul {
      justify-content: space-between;
      gap: 0.1rem;
    }

    :global(page-grid[data-layout="home"]) nav ul a {
      padding: 0.35rem 0.15rem;
      background: transparent !important;
      font-size: 0.77rem;
    }
  }
</style>
